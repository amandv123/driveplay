# Random secret of at least 32 characters; keep server-side only.
TRANSCODE_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Fixed source proxy; never accept per-request source URLs.
SOURCE_STREAM_BASE=https://driveplay-media.adtools.workers.dev/api/public/stream/
# Keep at 1 on small instances.
MAX_CONCURRENT_TRANSCODES=1
