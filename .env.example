# Frontend environment (copy to .env.local)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_MEDIA_API_URL=https://driveplay-media.YOUR-SUBDOMAIN.workers.dev

# Cloudflare Worker settings (configure in Cloudflare, not in this file):
# STREAM_ENCRYPTION_SECRET: random secret of at least 32 characters, set with:
#   npx wrangler secret put STREAM_ENCRYPTION_SECRET
# ALLOWED_ORIGINS: comma-separated deployed frontend origins, for example:
#   https://your-driveplay-site.pages.dev,https://driveplay.example.com
